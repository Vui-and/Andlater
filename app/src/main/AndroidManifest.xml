<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400001" android:required="false" />
    <uses-feature android:glEsVersion="0x00030002" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used to optionally fetch/update an OS image the user supplies a URL for; not required to install/run. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:label="Custom OS Emulator"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.CustomOSEmulator"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:largeHeap="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="Custom OS Emulator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen surface that renders the guest OS framebuffer and
             captures touch/keyboard input, per the "UI Layer" requirement. -->
        <activity
            android:name=".ui.EmulatorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:screenOrientation="sensorLandscape"
            android:hardwareAccelerated="true" />

        <!-- Runs the QEMU/native emulator process lifecycle independent of
             the UI so a rotated/backgrounded Activity doesn't kill the VM. -->
        <service
            android:name=".core.EmulatorService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>
</manifest>
